/*
 * File: display_float_seven_segment.cpp
 * 
 * Description:
 * This program demonstrates how to display floating-point numbers on an 8-bit
 * 7-segment display module using the mbed microcontroller platform.
 */

#include "mbed.h"

/* 
 * Hardware Setup:
 * 8-bit BusOut interface connected to 7-segment display segments (a-g + decimal point)
 * Pins: p5, p6, p7, p8, p9, p10, p11, p12
 */
BusOut display(p5, p6, p7, p8, p9, p10, p11, p12);

/* 
 * Function prototype for 7-segment pattern conversion
 */
int segConvert(int symbol);

/* 
 * Displays integer values by recursively breaking down multi-digit numbers
 * Handles negative numbers with '-' symbol display
 * Uses timed delays (500ms per digit, 1s blank) for sequential digit display
 */
void displayInt(int n)
{
    if (n < 0) {
        display = segConvert('-');
        wait_us(500000);
        n = -n;
    }
    if (n < 10) {
        display = segConvert(n);
        wait_us(500000);
        display = 0;
        wait_us(1000000);
    } else {
        int q, r;
        q = n / 10;
        r = n % 10;
        displayInt(q);
        displayInt(r);
    }
}

/* 
 * Displays up to 3 decimal digits of fractional component
 * Shows decimal point first, then extracts digits via integer truncation
 * Early exit when fractional part reaches zero
 */
void displayFrac(float f)
{
    display = segConvert('.');
    wait_us(500000);
    for (int digits = 1; digits <= 3; digits++) {
        int i = f * 10;
        display = segConvert(i);
        wait_us(500000);
        f = (f * 10) - i;
        if (f == 0) {
            break;
        }
    }
}

/* 
 * Main floating-point display function with rounding
 * Applies 0.0005 rounding correction for better decimal accuracy
 * Splits float into integer + fractional parts, handles negative values
 * Calls displayInt() and displayFrac() sequentially
 */
void displayFloat(float f)
{
    int i;
    float frac;
    f = f + 0.0005;
    if (f < 0) {
        display = segConvert('-');
        wait_us(500000);
        f = -f;
    }
    i = f;
    frac = f - i;
    displayInt(i);
    displayFrac(frac);
}

/* 
 * Main loop continuously displays 3.14 as demonstration
 * Infinite loop calls displayFloat() repeatedly
 */
int main()
{
    while (true) {
        displayFloat(3.14);
    }
}

/* 
 * Converts numeric symbols (0-9) and special characters ('-', '.') 
 * to 7-segment display binary patterns (common cathode assumed)
 * Bit mapping: [dp,g,f,e,d,c,b,a] where dp=decimal point
 */
int segConvert(int symbol)
{
    switch (symbol) {
        case 0:  return 0b00111111;
        case 1:  return 0b00000110;
        case 2:  return 0b01011011;
        case 3:  return 0b01001111;
        case 4:  return 0b01100110;
        case 5:  return 0b01101101;
        case 6:  return 0b01111101;
        case 7:  return 0b00000111;
        case 8:  return 0b01111111;
        case 9:  return 0b01101111;
        case '-': return 0b01000000;
        case '.': return 0b10000000;
        default:  return 0;
    }
}
