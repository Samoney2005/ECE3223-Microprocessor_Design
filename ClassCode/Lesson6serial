/*
 * Description:
 * ADC voltage/resistance measurement program with multiple commented exercises
 * Active: Exercise 6 - Measures analog input voltage on p20 and calculates resistance
 * Uses voltage divider formula: R = Vref × Rref / (Vref - Vadc)
 * Commented: Basic printf exercises + temperature sensor examples
 */

#include "mbed.h"

/* 
 * Hardware Setup:
 * AnalogIn on pin p20 (ADC input, typically 0-3.3V range)
 * External circuit: Voltage divider with 2kΩ reference resistor (Rref)
 * Potentiometer/resistor network connected between 3.3V, p20, and GND
 * Serial terminal required for printf output (USB UART)
 */
AnalogIn ain(p20);

/*
 * Averaging function for ADC noise reduction (100 samples)
 * Returns calibrated voltage in volts (0.0-3.3V range)
 * Used in commented Exercise 5 (temperature) and active Exercise 6
 */
float averageVoltage()
{
    // This goes with exercise 5
    float sum = 0;
    for (int i = 0; i < 100; i++){
        sum = sum + ain.read();
    }
    return (sum/100) * 3.3;  // Normalized ADC → actual voltage
}

