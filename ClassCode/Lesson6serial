/* 
 * ACTIVE EXERCISE 6: Voltage + Resistance measurement
 * Voltage divider: Vout = Vin × R2/(R1+R2), solved for R2 (unknown)
 * Formula: R_unknown = V_adc × Rref / (Vref - V_adc)
 * Rref = 2000Ω fixed reference resistor
 */
const float Rref = 2000;

int main()
{
    while(true){
        float f, volts, ohms; 
        volts = averageVoltage();
        ohms = volts * Rref / (3.3 - volts);
        printf(" volts = %f, ohms = %f \n", volts, ohms); 
        wait_us(1000000);
    }
}
