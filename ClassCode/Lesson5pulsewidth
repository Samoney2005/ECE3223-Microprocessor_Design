/* 
 * ACTIVE EXAMPLE 5: Smooth LED Breathing (100 Hz PWM carrier)
 * Sine-squared modulation for flicker-free brightness animation
 * ~6 second full cycle, modern non-deprecated timing
 */
PwmOut led(LED1);

int main()
{
    float theta = 0.0f;

    // Set PWM period to 1/100 s = 10 ms (100 Hz carrier)
    led.period(1.0f / 100.0f);

    while (true) {
        // duty cycle must be in [0,1]; sin²(theta) always between 0 and 1
        led = sinf(theta) * sinf(theta);

        // 10 ms delay (modern chrono literal syntax)
        ThisThread::sleep_for(10ms);

        theta += 0.1f;
        if (theta > 2.0f * 3.14159265f) {
            theta -= 2.0f * 3.14159265f; // keep theta bounded
        }
    }
}
