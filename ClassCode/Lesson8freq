/*
 * Description:
 * Frequency counter using edge detection on digital input p21
 * Measures input signal frequency (Hz) over 10-second gate time
 */

#include "mbed.h"

volatile int counter;
volatile float period,lasttime;
InterruptIn signal(p21);

void countEdge(void)
{
    counter++;
}

int main()
{
    signal.rise(countEdge);
    while (true) {
        int freq;
        counter = 0;
        wait_us(10000000);
        freq = counter;
        printf("%d Hz \n\r",freq);
    }
}

